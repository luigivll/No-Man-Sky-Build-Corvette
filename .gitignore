/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
# CI dumps the tail of a failing Windows build here; it is published as a run
# artifact and must never come back into the tree
ci-build-error.log
build.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# local render previews (generated by scripts/render-preview.ts)
/scripts/out

# extracted game meshes live here for local use only - see README
# Raw exported part models (user-supplied) are never committed...
/public/models/*
!/public/models/README.md
# ...but the generated shipyard pack IS, because the app cannot build without it.
!/public/models/corvette.bin
!/public/models/corvette.json
